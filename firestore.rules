rules_version = '2';

// This is the ONLY access-control layer in the app -- the frontend talks to
// Firestore directly from the browser (no backend server), so every check
// that used to live in server/auth/middleware.ts + the route handlers now
// has to be expressed here instead.
service cloud.firestore {
  match /databases/{database}/documents {

    function isApproved() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isApproved() && role() == "superadmin";
    }

    // Admin-tier or above. Super Admins get every Admin capability plus the
    // exclusive right to actually carry out a delete (see canEditRecord()
    // and the domain-collection "delete" rules below).
    function isAdmin() {
      return isApproved() && (role() == "admin" || role() == "superadmin");
    }

    // Granting the "superadmin" role normally requires an existing Super
    // Admin -- but the very first Super Admin has no one to grant it to
    // them. While meta/superadminSetup doesn't exist yet, any Admin may
    // grant "superadmin" (including to themselves); the client creates that
    // sentinel doc atomically alongside the grant, closing the window for
    // good after the first Super Admin exists.
    function canGrantSuperAdmin() {
      return isSuperAdmin() || (isAdmin() && !exists(/databases/$(database)/documents/meta/superadminSetup));
    }

    // Sentinel doc: its existence means an admin has already been
    // bootstrapped. Readable by anyone (even signed out) so the login page
    // can decide whether to show the first-run setup form -- mirrors the
    // old public GET /auth/setup-status endpoint. Created exactly once,
    // atomically alongside the first admin's users/{uid} doc.
    match /meta/setup {
      allow get: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.initializedBy &&
        !exists(/databases/$(database)/documents/meta/setup);
      allow update, delete: if false;
    }

    // Sentinel doc for the Super Admin bootstrap window described above.
    // Created exactly once, atomically alongside the first Super Admin's
    // users/{uid} role update.
    match /meta/superadminSetup {
      allow get: if isApproved();
      allow create: if isAdmin() &&
        request.auth.uid == request.resource.data.initializedBy &&
        !exists(/databases/$(database)/documents/meta/superadminSetup);
      allow update, delete: if false;
    }

    // Existence of a users/{uid} doc IS "approved"; its role field is the
    // permission level. Replaces the Firebase Auth custom claim. Granting or
    // revoking the "superadmin" role itself always requires an existing
    // Super Admin (see canGrantSuperAdmin() above for the one-time bootstrap
    // exception) -- otherwise a plain Admin could just promote themselves
    // at will and bypass the whole two-person deletion control.
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Two ways to create: (1) the very first user bootstraps themselves as
      // admin, only while meta/setup doesn't exist yet: (2) an existing
      // admin approves a pending request (or edits an existing user's role).
      allow create: if request.auth != null &&
        ((request.auth.uid == userId &&
          request.resource.data.role == "admin" &&
          !exists(/databases/$(database)/documents/meta/setup)) ||
         (isAdmin() && (request.resource.data.role != "superadmin" || canGrantSuperAdmin())));
      allow update: if isAdmin() &&
        (resource.data.role != "superadmin" || isSuperAdmin()) &&
        (request.resource.data.role != "superadmin" || canGrantSuperAdmin());
      // Admins can't remove themselves (mirrors the old self-delete guard).
      // Only a Super Admin may remove another Super Admin's account.
      allow delete: if isAdmin() && request.auth.uid != userId &&
        (resource.data.role != "superadmin" || isSuperAdmin());
    }

    // A user writes their own pending request at sign-up time; only admins
    // can see the queue and approve (delete + create users/{uid}) or deny
    // (delete only). Approving as "superadmin" is still gated by the
    // users/{userId} create rule above.
    match /pendingUsers/{userId} {
      allow get, list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Marks a Firebase Auth account for deletion after an admin removes a
    // users/{uid} doc. The client can never delete another user's Auth
    // account directly (no Admin SDK in the browser); it just queues this
    // doc, which a scheduled GitHub Actions job (Admin SDK) processes and
    // deletes -- freeing the email for someone else to sign up with.
    match /pendingAuthDeletions/{userId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }

    // A deletion (soft-delete into Trash Bin, or permanent delete from the
    // Trash Bin) requested by an Admin but not yet carried out. Only a Super
    // Admin can act on the queue -- approving performs the real write on the
    // target record and then removes this doc; rejecting just removes it.
    match /pendingDeletions/{id} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.requestedBy == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Shared shape for the five domain collections: any approved user
    // (admin or member) can read/create/edit records, matching the old
    // requireAuth-only routes. Only a Super Admin may actually flip
    // isDeleted/deletedAt into the trash (soft-delete) or hard-delete a
    // document -- an Admin has to go through pendingDeletions instead.
    // Restoring out of the trash is non-destructive, so it stays available
    // to any Admin (or Super Admin), same as before.
    function touchesDeletionFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(["isDeleted", "deletedAt"]);
    }

    function isRestoring() {
      return resource.data.isDeleted == true && request.resource.data.isDeleted == false;
    }

    function canEditRecord() {
      return isApproved() &&
        (!touchesDeletionFields() || (isRestoring() ? isAdmin() : isSuperAdmin()));
    }

    match /lightingPurchases/{id} {
      allow get, list: if isApproved();
      allow create: if isApproved();
      allow update: if canEditRecord();
      allow delete: if isSuperAdmin();
    }

    match /blumPurchases/{id} {
      allow get, list: if isApproved();
      allow create: if isApproved();
      allow update: if canEditRecord();
      allow delete: if isSuperAdmin();
    }

    match /tasks/{id} {
      allow get, list: if isApproved();
      allow create: if isApproved();
      allow update: if canEditRecord();
      allow delete: if isSuperAdmin();
    }

    match /issues/{id} {
      allow get, list: if isApproved();
      allow create: if isApproved();
      allow update: if canEditRecord();
      allow delete: if isSuperAdmin();
    }

    match /scheduleEvents/{id} {
      allow get, list: if isApproved();
      allow create: if isApproved();
      allow update: if canEditRecord();
      allow delete: if isSuperAdmin();
    }

    // Sibling collections holding the base64 file bytes for tasks/issues,
    // kept separate so list queries never have to transfer attachment data.
    // Write-once: there's no "replace attachment" flow. Removing an
    // attachment (while keeping the task/issue itself) is not "deleting an
    // entry", so it stays available to any Admin -- the two-tier approval
    // only applies to deleting the task/issue record itself, cleaned up via
    // useApproveDeletion's permanent-delete branch.
    match /taskFiles/{id} {
      allow get: if isApproved();
      allow create: if isApproved();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /issueFiles/{id} {
      allow get: if isApproved();
      allow create: if isApproved();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
