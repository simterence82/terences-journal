# Copy this file to .env and fill in real values before running the app.

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/journal.db

# Port the Express API server listens on.
PORT=3001
