# Copy this file to .env and fill in real values before running the app.

# --- Firebase (handles login, all app data, and file attachments -- see
# README for setup steps) ---
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These values are not secret (Firebase protects access via its own rules),
# safe to commit-adjacent, but kept in .env for per-environment flexibility.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed to run the trash-purge maintenance script locally (npm run
# purge) -- download the JSON key from Firebase Console -> Project settings
# -> Service accounts -> Generate new private key, and save it as
# firebase-service-account.json at the repo root (already gitignored). Not
# needed to run the app itself, since the app has no backend.
