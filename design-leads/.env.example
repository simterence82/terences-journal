# Copy this file to .env and fill in real values before running the app.

# --- Firebase (handles login and all app data -- see README for setup
# steps). This is a SEPARATE Firebase project from the one used by
# Terence's Journal (../.env.example) -- Studio Leads has its own login and
# its own data. ---
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These values are not secret (Firebase protects access via its own rules),
# safe to commit-adjacent, but kept in .env for per-environment flexibility.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
